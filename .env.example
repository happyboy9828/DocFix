# ---------------------------------------------------------------------------
# DocFix environment variables
# ---------------------------------------------------------------------------
# .env files are gitignored. This file (.env.example) is committed as the
# template - it must never contain real secrets.
#
# Vite exposes ONLY variables prefixed with VITE_ to the client bundle, and it
# does so by INLINING THEIR VALUES AT BUILD TIME. Anything marked "client"
# below is therefore PUBLIC the moment the site is deployed - it is safe for a
# project ID or publishable key, but it is NOT a secret and cannot be revoked by
# rotating the variable.
#
# Anything without the VITE_ prefix stays server-side (read via process.env in
# server.ts) and is never shipped to the browser. Use those for real secrets:
# API keys, database URLs, private keys, webhooks signing secrets.
# ---------------------------------------------------------------------------

# --- Server-only (NEVER prefixed with VITE_) --------------------------------

# Express server port.
PORT=3000

# Base URL used for robots.txt and sitemap.xml self-referential links.
APP_URL="https://docfix.pk"

# GEMINI_API_KEY: server-only AI key. Never expose this to the client.
# GEMINI_API_KEY=""

# Third-party secret keys, added here as they are integrated. All server-only.
# MONETAG_SCRIPT_SRC=""
# CLARITY_SERVER_API_TOKEN=""

# --- Client-exposed (VITE_ prefix = PUBLIC, build-time inlined) --------------

# VITE_CLARITY_PROJECT_ID: Microsoft Clarity project ID. Found in the Clarity
# dashboard under Settings > Project setup. This is a publishable identifier,
# not a secret - the same value appears in the Clarity script tag in the page
# source. Leave it blank to disable Clarity entirely.
VITE_CLARITY_PROJECT_ID=""